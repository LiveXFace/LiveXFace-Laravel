{
    "name": "idemity/laravel-sdk",
    "description": "Official Laravel SDK for Idemity — Face Recognition as a Service",
    "type": "library",
    "license": "MIT",
    "keywords": ["face-recognition", "biometrics", "api", "sdk", "laravel", "idemity"],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Idemity\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Idemity\\IdemityServiceProvider"
            ],
            "aliases": {
                "Idemity": "Idemity\\Facades\\Idemity"
            }
        }
    },
    "minimum-stability": "stable"
}
