{
    "name": "livexface/laravel-sdk",
    "description": "Official Laravel SDK for LiveXFace — Face Recognition as a Service",
    "type": "library",
    "license": "MIT",
    "keywords": ["face-recognition", "biometrics", "api", "sdk", "laravel", "livexface"],
    "homepage": "https://livexface.com",
    "support": {
        "issues": "https://github.com/livexface/livexface-laravel/issues",
        "source": "https://github.com/livexface/livexface-laravel"
    },
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "LiveXFace\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LiveXFace\\LiveXFaceServiceProvider"
            ],
            "aliases": {
                "LiveXFace": "LiveXFace\\Facades\\LiveXFace"
            }
        }
    },
    "minimum-stability": "stable"
}
