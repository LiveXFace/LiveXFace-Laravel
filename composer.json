{
    "name": "serupa/laravel-sdk",
    "description": "Official Laravel SDK for Serupa — Face Recognition as a Service",
    "type": "library",
    "license": "MIT",
    "keywords": ["face-recognition", "biometrics", "api", "sdk", "laravel", "serupa"],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Serupa\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Serupa\\SerupaServiceProvider"
            ],
            "aliases": {
                "Serupa": "Serupa\\Facades\\Serupa"
            }
        }
    },
    "minimum-stability": "stable"
}
